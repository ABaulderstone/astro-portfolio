---
// Light/dark toggle, rendered by Frame in the site footer (the frame's bottom inset, on the
// left). The theme follows prefers-color-scheme until the visitor picks one; the choice is
// saved to localStorage and applied before paint by the inline script in Base.astro.
// It starts hidden and the script reveals it, so it never shows up without JS to drive it.
const focusClass =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember-500';
---
<button
  type="button"
  id="theme-toggle"
  aria-label="Dark mode"
  aria-pressed="false"
  hidden
  class:list={[
    'flex size-[min(var(--nav-toggle-size),var(--frame-inset-bottom))] items-center justify-center text-nebula-600 dark:text-phosphor-400',
    focusClass,
  ]}
>
  <!-- Moon in light mode, sun in dark mode -->
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-7 dark:hidden" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
  </svg>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="hidden size-7 dark:block" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle')!;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && systemDark.matches);
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));

  button.addEventListener('click', () => {
    const theme = isDark() ? 'light' : 'dark';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    sync();
  });
  systemDark.addEventListener('change', sync);
  sync();
  button.hidden = false;
</script>
