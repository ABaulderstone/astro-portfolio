---
import MoonIcon from './icons/MoonIcon.astro';
import SunIcon from './icons/SunIcon.astro';

// Light/dark toggle, rendered by Frame in the site footer (the frame's bottom inset, on the
// left). The theme follows prefers-color-scheme until the visitor picks the other one; that
// choice is saved to localStorage and applied before paint by the inline script in Base.astro.
// Toggling back to the OS theme clears the saved choice.
// It starts hidden and the script reveals it, so it never shows up without JS to drive it.
const focusClass =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember-500';
---
<button
  type="button"
  id="theme-toggle"
  aria-label="Dark mode"
  aria-pressed="false"
  hidden
  class:list={[
    'flex size-[min(var(--nav-toggle-size),var(--frame-inset-bottom))] items-center justify-center text-nebula-600 dark:text-phosphor-400',
    focusClass,
  ]}
>
  <!-- Moon in light mode, sun in dark mode -->
  <MoonIcon class="size-7 dark:hidden" />
  <SunIcon class="hidden size-7 dark:block" />
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle')!;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && systemDark.matches);
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));

  // Picking the theme the OS already uses clears the override, so the site goes back to
  // following prefers-color-scheme (and any scheduled OS switching) instead of pinning it.
  button.addEventListener('click', () => {
    const theme = isDark() ? 'light' : 'dark';
    const matchesSystem = (theme === 'dark') === systemDark.matches;
    if (matchesSystem) delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (matchesSystem) localStorage.removeItem('theme');
      else localStorage.setItem('theme', theme);
    } catch {}
    sync();
  });
  systemDark.addEventListener('change', sync);
  sync();
  button.hidden = false;
</script>
