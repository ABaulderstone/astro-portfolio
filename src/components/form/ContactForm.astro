---
// The contact form: name, email, an optional mobile number and message, one field per line,
// checked by the browser (no client JS). `error` is a message about the whole form (a failed
// send, say), shown below the fields beside the button; its room is reserved either way. `action` and `method` say where it submits.
import FormField from './FormField.astro';
import SubmitButton from './SubmitButton.astro';

interface Props {
	action?: string;
	method?: 'get' | 'post';
	error?: string;
}

const { action, method = 'post', error } = Astro.props;
---
<!-- No gap between fields: each one's reserved error line spaces it from the next -->
<form {action} {method} aria-label="Contact" class="flex flex-col">
	<FormField name="name" label="Name" autocomplete="name" placeholder="Your name" required error="Please enter your name." />
	<FormField name="email" label="Email" type="email" autocomplete="email" placeholder="you@example.com" required error="Please enter a valid email address." />
	<!-- Lenient: digits with spaces, brackets, dashes and an optional leading + -->
	<FormField name="mobile" label="Mobile (optional)" type="tel" autocomplete="tel" placeholder="0400 000 000" pattern="\+?[0-9 \(\)\-]{8,20}" error="Please enter a valid phone number." />
	<FormField name="message" label="Message" type="textarea" rows={3} fieldClass="short:md:h-24" placeholder="What would you like to talk about?" required minlength={10} error="Please enter a message of at least 10 characters." />
	<!-- The form's error sits beside the button, wrapping below it on a narrow screen -->
	<div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-2">
		<SubmitButton>Send</SubmitButton>
		<p role="alert" class="text-ember-600 dark:text-ember-400">{error}</p>
	</div>
</form>
