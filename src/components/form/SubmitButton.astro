---
// A form's submit button, filled with the frame colour. The label is the slot.
---
<button
	type="submit"
	class="min-h-11 bg-nebula-600 px-6 py-3 font-heading text-base text-paper-50 hover:bg-nebula-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nebula-600 dark:bg-phosphor-400 dark:text-void-950 dark:hover:bg-phosphor-300 dark:focus-visible:outline-phosphor-400"
>
	<slot />
</button>
