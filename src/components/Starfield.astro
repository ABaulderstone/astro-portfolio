---
// A slowly drifting, twinkling field of pixel stars in the frame colour, for the background of a
// Frame page. It fills the frame inside the border. Pure CSS: each layer is a repeating SVG tile
// used as a mask over a frame-coloured background, so the stars follow the theme. Content placed
// after it needs `relative` to paint above it. With reduced motion the stars hold still.

// Seeded random numbers (mulberry32), so every build draws the same sky
function random(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// A square tile of stars as an SVG data URI. Positions snap to the star size so edges stay crisp.
// Plus-shaped stars are the "radiant points".
function stars({ tile, count, size, plus = false, seed }: { tile: number; count: number; size: number; plus?: boolean; seed: number }) {
  const next = random(seed);
  const span = plus ? size * 3 : size;
  const snap = (n: number) => Math.floor((n * (tile - span)) / size) * size;
  const shapes = Array.from({ length: count }, () => {
    const x = snap(next());
    const y = snap(next());
    return plus
      ? `<rect x="${x + size}" y="${y}" width="${size}" height="${span}"/><rect x="${x}" y="${y + size}" width="${span}" height="${size}"/>`
      : `<rect x="${x}" y="${y}" width="${size}" height="${size}"/>`;
  }).join('');
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${tile}" height="${tile}" shape-rendering="crispEdges">${shapes}</svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}

// Far to near: nearer layers drift faster (parallax; speed is tile / duration, from ~1px/s to
// ~6px/s). Tiles are large and unevenly sized so the repeat isn't noticeable. alpha is how much
// frame colour the stars get (scaled by --starfield-strength per theme).
const layers = [
  { tile: 397, alpha: 35, duration: 397, twinkle: 0, image: stars({ tile: 397, count: 43, size: 2, seed: 1 }) },
  { tile: 541, alpha: 50, duration: 186, twinkle: 0, image: stars({ tile: 541, count: 19, size: 2, seed: 2 }) },
  { tile: 733, alpha: 70, duration: 131, twinkle: 6, image: stars({ tile: 733, count: 8, size: 2, plus: true, seed: 3 }) },
  { tile: 977, alpha: 70, duration: 171, twinkle: 9, image: stars({ tile: 977, count: 12, size: 2, plus: true, seed: 4 }) },
];
---
<div class="starfield" aria-hidden="true">
  {layers.map(({ tile, alpha, duration, twinkle, image }) => (
    <div
      class:list={['layer', { twinkle: twinkle > 0 }]}
      style={`--tile: ${tile}px; --alpha: ${alpha}%; --duration: ${duration}s; --twinkle: ${twinkle}s; --stars: ${image}`}
    />
  ))}
</div>

<style>
  .starfield {
    position: absolute;
    inset: var(--frame-width);
    overflow: hidden;
    pointer-events: none;
  }

  /* One tile bigger than the field, drifting up and left by exactly one tile so it loops seamlessly */
  .layer {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% + var(--tile));
    height: calc(100% + var(--tile));
    --ink: color-mix(in oklab, var(--frame-color) calc(var(--alpha) * var(--starfield-strength)), transparent);
    /* A gradient rather than background-color: axe ignores the mask, so it would read a solid
       colour as the background behind the text and report a false contrast failure */
    background-image: linear-gradient(var(--ink), var(--ink));
    mask: var(--stars) 0 0 / var(--tile) var(--tile) repeat;
    animation: drift var(--duration) linear infinite;
  }

  .twinkle {
    animation:
      drift var(--duration) linear infinite,
      twinkle var(--twinkle) ease-in-out infinite alternate;
  }

  /* Out of step with the first twinkling layer */
  .twinkle:last-of-type {
    animation-delay: 0s, calc(var(--twinkle) / -2);
  }

  @keyframes drift {
    to {
      transform: translate(calc(-1 * var(--tile)), calc(-1 * var(--tile)));
    }
  }

  @keyframes twinkle {
    to {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .twinkle {
      animation: none;
    }
  }
</style>
