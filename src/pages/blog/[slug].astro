---
import { render } from 'astro:content';
import ChevronLeftIcon from '../../components/icons/ChevronLeftIcon.astro';
import ChevronRightIcon from '../../components/icons/ChevronRightIcon.astro';
import Frame from '../../layouts/Frame.astro';
import { byYear, formatDate, getPosts, readingTime, type Post } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, posts, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	posts: Post[];
	newer?: Post;
	older?: Post;
}

const { post, posts, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
const url = new URL(Astro.url.pathname, Astro.site);

// Structured data so search engines can show the post as an article. `<` is escaped so the
// JSON can't close its script tag.
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Alex Baulderstone', url: Astro.site },
	url,
	mainEntityOfPage: url,
	keywords: tags.join(', '),
}).replaceAll('<', '\\u003c');

const arrowClass =
	'flex size-11 shrink-0 items-center justify-center hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-ember-500 dark:text-phosphor-400 dark:hover:text-ember-400';
---
<Frame title={`${title} | Alex Baulderstone`} {description} type="article" publishedTime={pubDate} modifiedTime={updatedDate} panels>
	<script type="application/ld+json" slot="head" set:html={jsonLd} />
	<!--
		Mobile: a title bar, the post, and a bar with arrows to the older and newer posts.
		md+: a title bar, then an index of every post (by year) beside the post.
		Posts are reached by clicking between them, so the lines don't draw in (edges-static).
	-->
	<div class="panels edges-static grid-rows-[auto_1fr_auto] md:grid-cols-[minmax(16rem,1fr)_3fr] md:grid-rows-[auto_1fr] lg:grid-cols-[minmax(20rem,1fr)_3fr]">
		<div class="edge-b p-5 text-center md:col-span-2 md:p-8 short:md:py-4">
			<a href="/blog/" class="font-heading text-2xl leading-normal hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember-500 md:text-[2rem] dark:text-phosphor-300 dark:hover:text-ember-400">Blog</a>
		</div>

		<div class="min-h-0 max-md:hidden">
			<nav aria-label="All posts" tabindex="0" class="scroll-shadow h-full overflow-y-auto p-8 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-ember-500 short:p-5">
				{byYear(posts).map(([year, posts]) => (
					<section class="mt-8 first:mt-0">
						<h2 class="text-base leading-normal">{year}</h2>
						<!-- A square marks the post you're reading, like the career timeline's nodes -->
						<ul class="mt-4 space-y-4">
							{posts.map((entry) => (
								<li>
									<a
										href={`/blog/${entry.id}/`}
										aria-current={entry.id === post.id ? 'page' : undefined}
										class="relative block pl-6 leading-snug before:absolute before:top-1.5 before:left-0 before:size-3 before:border-2 before:border-(--frame-color) hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember-500 aria-[current=page]:font-bold aria-[current=page]:before:bg-(--frame-color) lg:text-fluid dark:text-phosphor-300 dark:hover:text-ember-400"
									>
										{entry.data.title}
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</nav>
		</div>

		<!-- min-w-0 so a wide code block scrolls inside itself rather than widening the grid -->
		<div class="min-h-0 min-w-0 max-md:edge-b md:edge-l">
			<!-- Scrolls when the post outgrows the panel (see the about page's Bio region) -->
			<div
				role="region"
				aria-labelledby="post-title"
				tabindex="0"
				class="scroll-shadow h-full overflow-y-auto p-5 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-ember-500 md:p-8 lg:p-10 xl:p-12 2xl:p-16 short:md:p-6"
			>
				<article class="mx-auto max-w-[70ch]">
					<header>
						<h1 id="post-title" class="text-base leading-normal md:text-2xl lg:text-[2rem]">{title}</h1>
						<p class="mt-4 text-sm lg:text-base">
							<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
							{updatedDate && <>{' '}(updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>)</>}
							<span aria-hidden="true"> · </span>{readingTime(post.body ?? '')} min read
						</p>
						{tags.length > 0 && (
							<ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
								{tags.map((tag) => (
									<li class="border-2 border-(--frame-color) px-2 py-0.5 text-sm">{tag}</li>
								))}
							</ul>
						)}
					</header>
					<div class="prose prose-site mt-8 max-w-none lg:text-fluid">
						<Content />
					</div>
				</article>
			</div>
		</div>

		<!-- Mobile only: older post on the left, newer on the right, like the career timeline -->
		<nav aria-label="More posts" class="flex items-center justify-between px-2 py-1 md:hidden">
			{older ? (
				<a href={`/blog/${older.id}/`} aria-label={`Older post: ${older.data.title}`} class={arrowClass}>
					<ChevronLeftIcon class="size-6" />
				</a>
			) : <span class="size-11 shrink-0" />}
			<a href="/blog/" class="font-heading text-base leading-normal hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember-500 dark:text-phosphor-300 dark:hover:text-ember-400">All posts</a>
			{newer ? (
				<a href={`/blog/${newer.id}/`} aria-label={`Newer post: ${newer.data.title}`} class={arrowClass}>
					<ChevronRightIcon class="size-6" />
				</a>
			) : <span class="size-11 shrink-0" />}
		</nav>
	</div>
</Frame>
