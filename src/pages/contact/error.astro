---
import ChevronLeftIcon from '../../components/icons/ChevronLeftIcon.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Frame from '../../layouts/Frame.astro';
---
<!-- Where the contact endpoint sends a message it couldn't take (it failed a check, or storing or
     emailing it failed). Kept out of search results and the sitemap (astro.config.mjs). -->
<Frame title="Message not sent | Alex Baulderstone" description="Your message to Alex Baulderstone couldn't be sent. Please try again or get in touch another way.">
	<meta name="robots" content="noindex" slot="head" />
	<div class="flex flex-1 flex-col items-center justify-center text-center">
		<h1 class="text-2xl leading-normal md:text-[2rem]">Message not sent</h1>
		<p class="mt-6 max-w-[60ch] lg:text-fluid">Sorry, something went wrong and your message didn't send. Please try again, or find me on one of these instead.</p>
		<SocialLinks compact class="mt-6" />
		<a href="/contact/" class="mt-8 flex min-h-11 items-center gap-2 font-heading text-base hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember-500 dark:hover:text-ember-400">
			<ChevronLeftIcon class="size-6 shrink-0" />
			Back to the form
		</a>
	</div>
</Frame>
