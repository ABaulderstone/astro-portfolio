---
import { getCollection } from 'astro:content';
import ChevronLeftIcon from '../components/icons/ChevronLeftIcon.astro';
import ChevronRightIcon from '../components/icons/ChevronRightIcon.astro';
import PauseIcon from '../components/icons/PauseIcon.astro';
import PlayIcon from '../components/icons/PlayIcon.astro';
import StackIcon from '../components/icons/StackIcon.astro';
import Frame from '../layouts/Frame.astro';

// One job per company, spanning its roles (listed newest first). Newest job first; it's shown
// when the URL has no hash.
const jobs = (await getCollection('career'))
	.map((job) => ({ ...job, start: job.data.roles.at(-1)!.start, end: job.data.roles[0].end, ...marquee(job.data.stack) }))
	.sort((a, b) => b.start.getTime() - a.start.getTime());

// On mobile a stack shows as one row of chips, scrolling as a marquee if it won't fit. CSS can't
// tell when a row overflows, so estimate it here: about 7px a character at 14px, plus each chip's
// padding, border and gap, against a phone's panel (about 300px). The duration keeps the speed
// at about 40px a second whatever the length.
function marquee(stack: string[]) {
	const width = stack.reduce((total, tech) => total + tech.length * 7 + 28, 0);
	return { scrolls: width > 300, duration: `${Math.round(width / 40)}s` };
}

const year = (date: Date) => date.getUTCFullYear();
const years = ({ start, end }: { start: Date; end?: Date }) =>
	end && year(end) === year(start) ? `${year(start)}` : `${year(start)} - ${end ? year(end) : 'Now'}`;
const month = (date: Date) => date.toLocaleString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const isoMonth = (date: Date) => date.toISOString().slice(0, 7);

// The URL hash is the state, so it needs no JS: each job's article has the job's id
// (/career/#coder-academy), every job's details, stack and mobile bar are rendered up front and
// hidden, and these rules show the set whose article is the :target, plus fill its timeline
// node. With no hash, or one that matches no job, the newest job shows. Entry ids are file
// slugs, so they're safe in selectors (just don't name a file after another id on the page,
// like main.md). Shown elements use their --shown display, block by default.
const showSelected = jobs
	.map(({ id, scrolls }, i) => {
		const selected = [`.career:has(#${id}:target)`, ...(i === 0 ? ['.career:not(:has(article:target))'] : [])];
		const within = (selector: string) => selected.map((s) => `${s} ${selector}`).join(', ');
		return `${within(`[data-job="${id}"]`)} { display: var(--shown, block); }
${within(`[data-node="${id}"]`)} { background: var(--frame-color); }${
			scrolls ? `\n${within('[data-marquee-pause]')} { display: flex; }` : ''
		}`;
	})
	.join('\n');

const arrowClass =
	'flex size-11 shrink-0 items-center justify-center text-nebula-600 hover:text-ember-600 focus-visible:outline-2 focus-visible:outline-ember-500 dark:text-phosphor-400 dark:hover:text-ember-400';
---
<Frame title="Career | Alex Baulderstone" description="Alex Baulderstone's career as a software engineer: roles, highlights and the tech stack behind each one." panels>
	<style is:inline set:html={showSelected}></style>
	<!--
		Mobile: one column, with the details taking the spare height. The timeline runs across,
		oldest on the left, with a bar for the selected job and arrows to the jobs either side.
		md: title bar, then the timeline and stack stacked on the left beside the details (like about).
		lg: title bar, then three columns: timeline | details | stack.
		Lines draw in order: mobile top to bottom; desktop title, the details' divider, then the rest.
	-->
	<div class="career panels grid-rows-[auto_auto_1fr_auto] md:grid-cols-[minmax(18rem,1fr)_3fr] md:grid-rows-[auto_1fr_auto] lg:grid-cols-[minmax(18rem,1fr)_3fr_minmax(14rem,1fr)] lg:grid-rows-[auto_1fr]">
		<div class="edge-b p-5 md:col-span-2 md:p-8 lg:col-span-3 short:md:py-4">
			<h1 class="text-center text-2xl leading-normal md:text-[2rem]">Career</h1>
		</div>

		<nav aria-label="Career timeline" class="p-5 [--edge-delay:150ms] max-lg:edge-b max-md:pb-3 md:p-8 short:md:p-5 md:[--edge-delay:750ms] md:[--edge-origin:right]">
			<!-- Mobile: nodes on a horizontal line, oldest first (row-reverse, as the list is newest
			     first), with their text visually hidden. md+: a vertical line with the text beside it. -->
			<ol class="relative flex flex-row-reverse justify-between before:absolute before:inset-x-4 before:top-1/2 before:h-1 before:-translate-y-1/2 before:bg-(--frame-color) md:block md:space-y-8 md:before:hidden">
				{jobs.map((job) => (
					<li class="relative md:before:absolute md:before:top-2 md:before:-bottom-10 md:before:left-1 md:before:w-1 md:before:bg-(--frame-color) md:last:before:hidden 3xl:before:top-3 3xl:before:left-1.5">
						<a
							href={`#${job.id}`}
							class="group flex size-8 items-center justify-center text-paper-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember-500 md:block md:size-auto md:pl-8 dark:text-void-200"
						>
							<!-- Fills in when its job is selected -->
							<span data-node={job.id} class="size-4 border-2 border-(--frame-color) bg-paper-100 md:absolute md:top-0.5 md:left-0 md:size-3 dark:bg-void-950 3xl:top-1.5 3xl:size-4" aria-hidden="true"></span>
							<span class="block font-heading text-base leading-normal text-nebula-600 group-hover:text-ember-600 max-md:sr-only dark:text-phosphor-300 dark:group-hover:text-ember-400 3xl:text-2xl">{years(job)}</span>
							<span class="mt-1 block font-bold max-md:sr-only lg:text-fluid">{job.data.company}</span>
							<span class="block max-md:sr-only lg:text-fluid">{job.data.roles[0].title}</span>
						</a>
					</li>
				))}
			</ol>
			<!-- Mobile only: the selected job, with arrows to the earlier and later ones -->
			<div class="mt-3 md:hidden">
				{jobs.map((job, i) => {
					const later = jobs[i - 1];
					const earlier = jobs[i + 1];
					return (
						<div data-job={job.id} class="hidden items-center justify-between gap-2 [--shown:flex]">
							{earlier ? (
								<a href={`#${earlier.id}`} aria-label={`Earlier: ${earlier.data.company}`} class={arrowClass}>
									<ChevronLeftIcon class="size-6" />
								</a>
							) : <span class="size-11 shrink-0" />}
							<p class="text-center">
								<span class="block font-heading text-base leading-normal text-nebula-600 dark:text-phosphor-300">{years(job)}</span>
								<span class="font-bold">{job.data.company}</span>
							</p>
							{later ? (
								<a href={`#${later.id}`} aria-label={`Later: ${later.data.company}`} class={arrowClass}>
									<ChevronRightIcon class="size-6" />
								</a>
							) : <span class="size-11 shrink-0" />}
						</div>
					);
				})}
			</div>
		</nav>

		<section class="min-h-0 [--edge-delay:300ms] max-md:edge-b md:col-start-2 md:row-span-2 md:row-start-2 md:edge-l md:[--edge-delay:400ms] lg:row-span-1">
			<!-- Scrolls when a job's text outgrows the panel (see the about page's Bio region). The
			     padding is on each article rather than this wrapper, so jumping to an article's hash
			     scrolls the panel to the very top. Articles take focus when targeted, so screen
			     readers follow to the new details. -->
			<div
				id="job-details"
				role="region"
				aria-label="Role details"
				tabindex="0"
				class="scroll-shadow h-full overflow-y-auto focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-ember-500"
			>
				{jobs.map(({ id, data }) => (
					<article id={id} data-job={id} tabindex="-1" class="hidden p-5 outline-none md:p-8 lg:p-10 lg:text-fluid xl:p-12 2xl:p-16 short:md:p-6">
						<div class="mx-auto max-w-[70ch]">
							<h2 class="text-2xl leading-normal 3xl:text-[2rem]">{data.company}</h2>
							{data.roles.map((role) => (
								<section class="mt-8 first-of-type:mt-6">
									<h3 class="text-base leading-normal">{role.title}</h3>
									<p class="mt-1">
										<time datetime={isoMonth(role.start)}>{month(role.start)}</time>{' - '}
										{role.end ? <time datetime={isoMonth(role.end)}>{month(role.end)}</time> : 'Now'}
									</p>
									{role.summary && <p class="mt-3">{role.summary}</p>}
									<ul class="mt-3 list-disc space-y-2 pl-6 lg:leading-relaxed short:lg:leading-normal">
										{role.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
								</section>
							))}
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- min-w-0 so a marquee track (wider than the screen) can't widen the grid -->
		<section class="pattern-dots pattern-on-hover min-w-0 p-5 md:col-start-1 md:row-start-3 md:p-8 short:md:p-5 lg:col-start-3 lg:row-start-2 lg:edge-l lg:[--edge-delay:550ms]">
			<div class="flex items-center justify-between gap-2">
				<h2 class="flex items-center gap-2 text-base leading-normal 3xl:text-2xl">
					<StackIcon class="size-6 shrink-0 text-nebula-600 3xl:size-8 dark:text-phosphor-400" />
					Stack
				</h2>
				<!-- Pauses the marquee (WCAG 2.2.2). A checkbox, so it needs no JS. Shown on mobile, with
				     motion allowed, when the selected job's stack scrolls. -->
				<div class="-my-3 md:hidden motion-reduce:hidden">
					<label data-marquee-pause class="relative hidden size-11 cursor-pointer items-center justify-center text-nebula-600 hover:text-ember-600 dark:text-phosphor-400 dark:hover:text-ember-400">
						<input type="checkbox" id="pause-stack" class="peer sr-only" />
						<span class="sr-only">Pause the stack scrolling</span>
						<PauseIcon class="size-6 peer-checked:hidden" />
						<PlayIcon class="hidden size-6 peer-checked:block" />
						<span class="pointer-events-none absolute size-11 peer-focus-visible:outline-2 peer-focus-visible:outline-ember-500" aria-hidden="true"></span>
					</label>
				</div>
			</div>
			{jobs.map(({ id, data, scrolls, duration }) => {
				const marquee = scrolls ? 'motion-safe:max-md:flex-nowrap motion-safe:max-md:pr-2' : '';
				return (
					<div data-job={id} class:list={['mt-4 hidden max-md:mt-3', scrolls && 'motion-safe:max-md:overflow-hidden motion-safe:max-md:mask-x-from-85%']}>
						<!-- A long stack's track holds the list twice (the copy hidden from screen readers)
						     so the marquee loops seamlessly; it pauses on hover or with the button -->
						<div
							class:list={[scrolls && 'motion-safe:max-md:marquee motion-safe:max-md:flex hover:[animation-play-state:paused] in-[.career:has(#pause-stack:checked)]:[animation-play-state:paused]']}
							style={scrolls ? `--marquee-duration: ${duration}` : undefined}
						>
							<ul class:list={['flex flex-wrap gap-2', marquee]} aria-label={`Stack at ${data.company}`}>
								{data.stack.map((tech) => (
									<li class="border-2 border-(--frame-color) px-2 py-0.5 text-sm whitespace-nowrap lg:text-base 3xl:text-lg">{tech}</li>
								))}
							</ul>
							{scrolls && (
								<ul class="hidden gap-2 pr-2 motion-safe:max-md:flex" aria-hidden="true">
									{data.stack.map((tech) => (
										<li class="border-2 border-(--frame-color) px-2 py-0.5 text-sm whitespace-nowrap">{tech}</li>
									))}
								</ul>
							)}
						</div>
					</div>
				);
			})}
		</section>
	</div>
</Frame>
