---
import { getCollection, render } from 'astro:content';
import StackIcon from '../components/icons/StackIcon.astro';
import Frame from '../layouts/Frame.astro';

// Newest first; the newest job is selected when the page loads
const jobs = await Promise.all(
	(await getCollection('career'))
		.sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
		.map(async (job) => ({ ...job, Content: (await render(job)).Content })),
);

const year = (date: Date) => date.getUTCFullYear();
const dates = ({ start, end }: { start: Date; end?: Date }) => `${year(start)} - ${end ? year(end) : 'Now'}`;

// Picking a job is a radio group, so it needs no JS: each job's details and stack are rendered
// up front and hidden, and these rules show the pair whose radio is checked. Entry ids are file
// slugs, so they're safe in selectors.
const showSelected = jobs
	.map(({ id }) => `.career:has(#job-${id}:checked) {
		article[data-job="${id}"] { display: block; }
		ul[data-job="${id}"] { display: flex; }
	}`)
	.join('\n');
---
<Frame title="Career | Alex Baulderstone" description="Alex Baulderstone's career as a software engineer: roles, highlights and the tech stack behind each one." panels>
	<style is:inline set:html={showSelected}></style>
	<!--
		Mobile: one column, with the details taking the spare height.
		md: title bar, then the timeline and stack stacked on the left beside the details (like about).
		lg: title bar, then three columns: timeline | details | stack.
		Lines draw in order: mobile top to bottom; desktop title, the details' divider, then the rest.
	-->
	<div class="career panels grid-rows-[auto_auto_1fr_auto] md:grid-cols-[minmax(18rem,1fr)_3fr] md:grid-rows-[auto_1fr_auto] lg:grid-cols-[minmax(18rem,1fr)_3fr_minmax(14rem,1fr)] lg:grid-rows-[auto_1fr]">
		<div class="edge-b p-5 md:col-span-2 md:p-8 lg:col-span-3 short:md:py-4">
			<h1 class="text-center text-2xl leading-normal md:text-[2rem]">Career</h1>
		</div>

		<section class="p-5 [--edge-delay:150ms] max-lg:edge-b md:p-8 short:md:p-5 md:[--edge-delay:750ms] md:[--edge-origin:right]">
			<fieldset class="min-w-0">
				<legend class="sr-only">Choose a role</legend>
				<ol class="space-y-5 md:space-y-8">
					{jobs.map((job, i) => (
						<li class="relative before:absolute before:top-2 before:-bottom-7 before:left-1 before:w-1 3xl:before:top-3 3xl:before:left-1.5 before:bg-(--frame-color) last:before:hidden md:before:-bottom-10">
							<input
								type="radio"
								name="job"
								id={`job-${job.id}`}
								class="peer sr-only"
								checked={i === 0}
								aria-controls="job-details job-stack"
							/>
							<!-- The node fills in when its job is selected -->
							<label
								for={`job-${job.id}`}
								class="group block cursor-pointer pl-8 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-ember-500"
							>
								<span class="absolute top-0.5 left-0 size-3 border-2 3xl:top-1.5 3xl:size-4 border-(--frame-color) bg-paper-100 in-[li:has(:checked)]:bg-(--frame-color) dark:bg-void-950 dark:in-[li:has(:checked)]:bg-(--frame-color)" aria-hidden="true"></span>
								<span class="block font-heading text-base leading-normal text-nebula-600 3xl:text-2xl group-hover:text-ember-600 dark:text-phosphor-300 dark:group-hover:text-ember-400">{dates(job.data)}</span>
								<span class="mt-1 block font-bold lg:text-fluid">{job.data.company}</span>
								<span class="block max-md:hidden lg:text-fluid">{job.data.role}</span>
							</label>
						</li>
					))}
				</ol>
			</fieldset>
		</section>

		<section class="min-h-0 [--edge-delay:300ms] max-md:edge-b md:col-start-2 md:row-span-2 md:row-start-2 md:edge-l md:[--edge-delay:400ms] lg:row-span-1">
			<!-- Scrolls when a job's text outgrows the panel (see the about page's Bio region) -->
			<div
				id="job-details"
				role="region"
				aria-label="Role details"
				tabindex="0"
				class="scroll-shadow h-full overflow-y-auto p-5 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-ember-500 md:p-8 lg:p-10 xl:p-12 2xl:p-16 short:md:p-6"
			>
				{jobs.map(({ id, data, Content }) => (
					<article data-job={id} class="mx-auto hidden max-w-[70ch] lg:text-fluid">
						<h2 class="text-base leading-normal md:text-2xl 3xl:text-[2rem]">{data.role}</h2>
						<p class="mt-3 font-bold">{data.company}{data.location && <span class="font-normal"> · {data.location}</span>}</p>
						<p class="mt-1">
							<time datetime={data.start.toISOString().slice(0, 7)}>{year(data.start)}</time>{' - '}
							{data.end ? <time datetime={data.end.toISOString().slice(0, 7)}>{year(data.end)}</time> : 'Now'}
						</p>
						<div class="mt-6 space-y-4 lg:leading-relaxed [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 short:lg:leading-normal">
							<Content />
						</div>
					</article>
				))}
			</div>
		</section>

		<section id="job-stack" class="pattern-dots pattern-on-hover p-5 md:col-start-1 md:row-start-3 md:p-8 short:md:p-5 lg:col-start-3 lg:row-start-2 lg:edge-l lg:[--edge-delay:550ms]">
			<h2 class="flex items-center gap-2 text-base leading-normal 3xl:text-2xl">
				<StackIcon class="size-6 shrink-0 text-nebula-600 3xl:size-8 dark:text-phosphor-400" />
				Stack
			</h2>
			{jobs.map(({ id, data }) => (
				<ul data-job={id} class="mt-4 hidden flex-wrap gap-2" aria-label={`Stack at ${data.company}`}>
					{data.stack.map((tech) => (
						<li class="border-2 border-(--frame-color) px-2 py-0.5 text-sm lg:text-base 3xl:text-lg">{tech}</li>
					))}
				</ul>
			))}
		</section>
	</div>
</Frame>
