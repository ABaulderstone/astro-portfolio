---
import { Font } from 'astro:assets';
import '../styles/global.css';
const { title, description } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-roboto" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-press-start" preload />
    <!-- Apply a saved theme before first paint so there's no flash (see ThemeToggle) -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class="bg-paper-100 text-void-900 dark:bg-void-950 dark:text-phosphor-300">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <slot name="header" />
    <main id="main"><slot /></main>
  </body>
</html>