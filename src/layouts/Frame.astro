---
// src/layouts/Frame.astro
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---
<Base {...Astro.props}>
  <SiteNav slot="header" />
  <div class="frame">
    <div class="frame-border" aria-hidden="true"></div>
    <div class="mx-auto max-w-5xl">
      <slot />
    </div>
  </div>
  <!-- Sits in the frame's bottom inset: the negative margin cancels the frame's bottom margin -->
  <footer
    slot="footer"
    class="-mt-(--frame-inset-bottom) flex h-(--frame-inset-bottom) items-center px-(--frame-inset)"
  >
    <ThemeToggle />
  </footer>
</Base>
