---
// src/layouts/Frame.astro
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  /** Fill the frame edge to edge so a page can divide it with `.panels` (see global.css) */
  panels?: boolean;
}

const { panels = false, ...props } = Astro.props;
---
<Base {...props}>
  <SiteNav slot="header" />
  <div class:list={['frame', { 'frame-panels': panels }]}>
    <div class="frame-border" aria-hidden="true"></div>
    <!-- Fills the frame's height, so a page can centre content vertically with flex-1. The frame
         is one screen tall, so content that outgrows it scrolls here rather than the page. -->
    <div class:list={['flex min-h-0 w-full flex-1 flex-col overflow-y-auto', { 'mx-auto max-w-5xl': !panels }]}>
      <slot />
    </div>
  </div>
  <!-- Sits in the frame's bottom inset: the negative margin cancels the frame's bottom margin -->
  <footer
    slot="footer"
    class="-mt-(--frame-inset-bottom) flex h-(--frame-inset-bottom) items-center px-(--frame-inset)"
  >
    <ThemeToggle />
  </footer>
</Base>
